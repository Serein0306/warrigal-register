# Warrigal Park FC registration system - environment configuration
#
# Copy this file to .env.local for local overrides, or set the variables in CI.
# Variables prefixed with VITE_ are exposed to the client bundle at build time,
# so they must never contain secrets.
#
# The CI pipeline (deploy.yml) sets VITE_BASE automatically for GitHub Pages.

# Application title shown in the page header.
VITE_APP_TITLE=Warrigal Park FC

# Local storage key used to persist all club records in the browser.
VITE_STORAGE_KEY=wpfc.club.v1

# Season identifier used when a new registration is created.
VITE_CURRENT_SEASON=2026

# Date the season starts (used to decide whether a member is a junior, i.e.
# under 18, for the season). Format: YYYY-MM-DD.
VITE_SEASON_START=2026-03-01

# Base path for the built application.
#   Local development / root hosting  -> /
#   GitHub Pages project site          -> /<repository-name>/
VITE_BASE=/
# VITE_APP_MAX_REGISTRATION_AGE — maximum registration age limit
# VITE_APP_CLUB_NAME — display name of the football club
